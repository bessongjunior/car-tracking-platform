FLASK_ENV=development

# Database — leave unset or use sqlite:/// for local dev; set postgresql:// for production
# DATABASE_URL=postgresql://cartracker_user:password@localhost:5432/cartracker
DATABASE_URL=sqlite:///cartracker.db

# JWT
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=jwt-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Firebase
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=serviceAccountKey.json

# OTP
OTP_EXPIRY_SECONDS=300

# Gmail SMTP (OTP emails)
GMAIL_SENDER=noreply@tieftechnologiesltd.com
GMAIL_APP_PASSWORD=your-sixteen-char-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
