[Unit]
Description=CarTracker Fleet API
After=network.target postgresql.service

[Service]
User=cartracker
Group=cartracker
WorkingDirectory=/home/cartracker/car-tracking-platform/backend
Environment="FLASK_ENV=production"
EnvironmentFile=/home/cartracker/car-tracking-platform/backend/.env
ExecStart=/home/cartracker/car-tracking-platform/backend/venv/bin/gunicorn \
    --config gunicorn.conf.py \
    "api:create_app('production')"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
