# Copy this to backend/.env on the server and fill in every value.
# Never commit this file with real values.

FLASK_ENV=production

# PostgreSQL — create a dedicated DB user, not postgres superuser
DATABASE_URL=postgresql://cartracker_user:STRONG_PASSWORD@localhost:5432/cartracker

# Secrets — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
JWT_ACCESS_TOKEN_EXPIRES=3600

# Firebase
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=/home/cartracker/car-tracking-platform/backend/serviceAccountKey.json

# OTP
OTP_EXPIRY_SECONDS=300

# Gmail SMTP
GMAIL_SENDER=noreply@tieftechnologiesltd.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
